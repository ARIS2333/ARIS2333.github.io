---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEducation } from "../lib/content";
import { formatRange } from "../lib/format";

const entries = await getEducation();
---

<BaseLayout title="Education" description="Degrees and research training, from newest to oldest.">
  <div class="shell">
    <header class="page-header">
      <h1>Education</h1>
      <p class="lede">Degrees are listed from newest to oldest.</p>
    </header>
    <div class="record-list">
      {
        entries.map((entry) => (
          <article class="record">
            <h2>{entry.data.school}</h2>
            <div class="role-row">
              <h3>
                {entry.data.degree}, {entry.data.field}
              </h3>
              <p class="dates">{formatRange(entry.data.start, entry.data.end)}</p>
            </div>
            {(entry.data.advisor || entry.data.lab) && (
              <p class="meta-line">
                {entry.data.advisor && <>Advisor: {entry.data.advisor}</>}
                {entry.data.advisor && entry.data.lab && " · "}
                {entry.data.lab}
              </p>
            )}
            {(entry.data.thesis || entry.data.thesisUrl) && (
              <p class="meta-line">
                {entry.data.thesisUrl ? (
                  <a href={entry.data.thesisUrl}>{entry.data.thesis || "Thesis"}</a>
                ) : (
                  entry.data.thesis
                )}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
