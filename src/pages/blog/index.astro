---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogBrowser from "../../components/BlogBrowser.astro";
import { getBlogSections, getPublishedPosts, sortPostsByDate } from "../../lib/content";

const sections = await getBlogSections();
const posts = sortPostsByDate(await getPublishedPosts(), "asc");
---

<BaseLayout title="Blog" description="Technical notes on blockchain and smart contracts.">
  <BlogBrowser sections={sections} posts={posts} activeSlug={null} activeName="All notes" />
</BaseLayout>
