---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/content";
import { formatISODate, formatNewsDate } from "../../lib/format";

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="Technical notes from research and internships.">
  <div class="shell">
    <header class="page-header">
      <h1>Blog</h1>
      <p class="lede">Notes from research and internships.</p>
    </header>
    <ol class="post-list">
      {
        posts.map((post) => (
          <li>
            <h2>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <p class="post-meta">
              <time datetime={formatISODate(post.data.date)}>{formatNewsDate(post.data.date)}</time>
            </p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list">
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
