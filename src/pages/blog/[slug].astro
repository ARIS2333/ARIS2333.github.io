---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Toc from "../../components/Toc.astro";
import { getPublishedPosts } from "../../lib/content";
import { formatISODate, formatNewsDate } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing note slug.");

const post = await getEntry("blog", slug);
if (!post || post.data.draft !== false) {
  throw new Error(`Unpublished or missing note "${slug}".`);
}

const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="shell">
    <article class="article">
      <header class="article-header">
        <p class="kicker"><a href="/blog">Blog</a></p>
        <h1>{post.data.title}</h1>
        <p class="dek">{post.data.description}</p>
        <p class="post-meta">
          <time datetime={formatISODate(post.data.date)}>{formatNewsDate(post.data.date)}</time>
        </p>
        {
          post.data.tags.length > 0 && (
            <ul class="tag-list">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>
      <Toc headings={headings} />
      <div class="prose">
        <Content />
      </div>
      <p class="back"><a href="/blog">All notes</a></p>
    </article>
  </div>
</BaseLayout>
