---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { getFeaturedPhotos } from "../lib/gallery";
import Lightbox from "../components/Lightbox.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { paragraphs } from "../lib/format";
import { affiliationLine, cvHref, emailAddress, portrait, seekingFacts, socialLinks } from "../lib/profile";

const featured = getFeaturedPhotos();
const cv = cvHref();
const email = emailAddress();
const socials = socialLinks();
const github = socials.find((item) => item.key === "github");
const linkedin = socials.find((item) => item.key === "linkedin");
const scholar = socials.find((item) => item.key === "scholar");
const affiliation = affiliationLine();
const seeking = seekingFacts();
const photo = portrait();
const intro = paragraphs(site.bio);
const focusLines = site.researchFocus
  .map((line) => line.trim().replaceAll("–", "–\u2060"))
  .filter(Boolean);
---

<BaseLayout
  title={site.name}
  description={intro[0]?.replace(/<[^>]+>/g, "") || affiliation || site.name}
>
  <div class="home">
    <section class="identity" aria-labelledby="profile-name">
        <div class="identity-heading">
          {
            photo.image ? (
              <Image
                class="portrait"
                src={photo.image}
                alt={photo.alt}
                width={320}
                widths={[128, 256, 320, 640]}
                sizes="(max-width: 720px) 6rem, 15rem"
                format="webp"
                loading="eager"
                fetchpriority="high"
              />
            ) : photo.src.startsWith("/") ? (
              <img class="portrait" src={photo.src} alt={photo.alt} width="1024" height="847" />
            ) : null
          }
          <div>
            <h1 class="name" id="profile-name">{site.name}</h1>
            {affiliation && <p class="affiliation">{affiliation}</p>}
          </div>
        </div>
        {
          focusLines.length > 0 && (
            <ul class="research">
              {focusLines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          )
        }
        {
          seeking && (
            <div class="seeking">
              <span class="seeking-kicker">Seeking internship</span>
              <dl class="seeking-facts">
                {seeking.roles && (
                  <div>
                    <dt>Role</dt>
                    <dd>{seeking.roles}</dd>
                  </div>
                )}
                {seeking.areas && (
                  <div>
                    <dt>Area</dt>
                    <dd>{seeking.areas}</dd>
                  </div>
                )}
                {seeking.when && (
                  <div>
                    <dt>When</dt>
                    <dd>{seeking.when}</dd>
                  </div>
                )}
              </dl>
            </div>
          )
        }
        {
          (cv || email || github || scholar || linkedin) && (
            <div class="contact">
              {cv && (
                <a class="button" href={cv} download>
                  Download CV
                </a>
              )}
              {(email || github || scholar || linkedin) && (
                <div class="contact-links">
                  {
                    email && (
                      <a class="icon-link" href={`mailto:${email}`}>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            fill="currentColor"
                            d="M2 4.5h20v15H2v-15zm2 2v.6l8 5.3 8-5.3V6.5H4zm16 2.2-8 5.3-8-5.3V17.5h16V8.7z"
                          />
                        </svg>
                        <span>{email}</span>
                      </a>
                    )
                  }
                  {
                    github && (
                      <a class="icon-link" href={github.href} target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.3c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z" />
                        </svg>
                        <span>GitHub</span>
                      </a>
                    )
                  }
                  {
                    scholar && (
                      <a class="icon-link" href={scholar.href} target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            fill="currentColor"
                            d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zM6.5 13.2V16c0 1.6 2.5 2.9 5.5 2.9s5.5-1.3 5.5-2.9v-2.8L12 16.4l-5.5-3.2z"
                          />
                        </svg>
                        <span>Google Scholar</span>
                      </a>
                    )
                  }
                  {
                    linkedin && (
                      <a class="icon-link" href={linkedin.href} target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            fill="currentColor"
                            d="M4.7 3.3A2.2 2.2 0 1 1 2.5 5.5a2.2 2.2 0 0 1 2.2-2.2zM3 8.4h3.4V21H3V8.4zm5.6 0H12v1.7h.1c.5-.9 1.7-1.9 3.5-1.9 3.7 0 4.4 2.4 4.4 5.6V21h-3.4v-6.3c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V21H8.6V8.4z"
                          />
                        </svg>
                        <span>LinkedIn</span>
                      </a>
                    )
                  }
                </div>
              )}
            </div>
          )
        }
      </section>

      <div class="home-main">
        {
          intro.length > 0 && (
            <section class="about" aria-labelledby="about">
              <div class="section-head">
                <h2 id="about">About</h2>
              </div>
              <div class="intro-copy">
                {intro.map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
              </div>
            </section>
          )
        }

        <section class="highlights" aria-labelledby="highlights">
          <div class="section-head">
            <h2 id="highlights">Selected Highlights</h2>
          </div>
          <div class="highlights-grid">
            <div class="highlight-track">
              <div class="highlight-track-head">
                <span class="highlight-kicker">Education &amp; Teaching</span>
                <a href="/publications">Publications &rarr;</a>
              </div>
              <ul class="highlight-list">
                <li>
                  <a href="/publications#codeflow-sigcse-2026">
                    <span class="highlight-item-head">
                      <span class="highlight-title">CodeFlow</span>
                      <span class="highlight-meta">SIGCSE TS 2026</span>
                    </span>
                    <span class="highlight-desc">LLM-generated flowchart feedback for visual debugging; piloted in CS1 Java.</span>
                  </a>
                </li>
                <li>
                  <a href="/publications#ai-engagement-k12-sigcse-2027">
                    <span class="highlight-item-head">
                      <span class="highlight-title">Grades 6–12 AI Curriculum</span>
                      <span class="highlight-meta">SIGCSE TS 2027</span>
                    </span>
                    <span class="highlight-desc">Multi-year computing pathway for supervised, industry-relevant AI use.</span>
                  </a>
                </li>
                <li>
                  <a href="/experience">
                    <span class="highlight-item-head">
                      <span class="highlight-title">Teaching Assistant</span>
                      <span class="highlight-meta">Utah State University</span>
                    </span>
                    <span class="highlight-desc">Recitation sessions, debugging Q&amp;A, and actionable assignment feedback.</span>
                  </a>
                </li>
              </ul>
            </div>

            <div class="highlight-track">
              <div class="highlight-track-head">
                <span class="highlight-kicker">Blockchain &amp; Security</span>
                <a href="/blog">Blog &rarr;</a>
              </div>
              <ul class="highlight-list">
                <li>
                  <a href="/experience">
                    <span class="highlight-item-head">
                      <span class="highlight-title">Bybit Security Internship</span>
                      <span class="highlight-meta">8 months</span>
                    </span>
                    <span class="highlight-desc">Smart contract and bridge audits, permission boundaries, incident reconstruction.</span>
                  </a>
                </li>
                <li>
                  <a href="/blog/section/inside-ethereum">
                    <span class="highlight-item-head">
                      <span class="highlight-title">Ethereum Internals</span>
                      <span class="highlight-meta">49 notes</span>
                    </span>
                    <span class="highlight-desc">Source-code walkthroughs of EELS and Geth from tries and EVM to sync.</span>
                  </a>
                </li>
                <li>
                  <a href="/blog/section/cross-chain">
                    <span class="highlight-item-head">
                      <span class="highlight-title">Cross-Chain &amp; Incident Analysis</span>
                      <span class="highlight-meta">5 notes</span>
                    </span>
                    <span class="highlight-desc">Security analyses of Hyperlane, LayerZero, CCIP, CCTP, and CrossCurve.</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </section>

        {
          featured.length > 0 && (
            <>
              <a class="photo-scroll-cue" href="#featured-photographs">
                <span>Scroll down to see my photographs</span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 4v16m-6-6 6 6 6-6" />
                </svg>
              </a>
              <section class="gallery" id="featured-photographs" aria-labelledby="gallery">
                <div class="section-head">
                  <h2 id="gallery">Featured Photographs</h2>
                  <a href="/gallery">All photographs →</a>
                </div>
                <PhotoGrid photos={featured} featured mosaic />
              </section>
            </>
          )
        }
      </div>
  </div>
  <Lightbox />
</BaseLayout>
