---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublications, groupByYear } from "../lib/content";
import { formatAuthors } from "../lib/profile";

const publications = await getPublications();
const groups = groupByYear(publications);

const titleText = (title: string) =>
  title.replaceAll("-", "\u2011").replaceAll("\u2013", "\u2060\u2013\u2060");
---

<BaseLayout
  title="Publications"
  description="Papers in reverse chronological order, with links to a manuscript, code, or project when one exists."
>
  <div class="shell pub-page">
    <header class="page-header">
      <h1>Publications</h1>
    </header>
    {
      groups.map((group) => (
        <section class="year-block" aria-labelledby={`year-${group.year}`}>
          <h2 id={`year-${group.year}`}>{group.year}</h2>
          <ol class="pub-list">
            {group.items.map((item) => {
              const paper = item.data.links?.paper;
              const pdf = item.data.links?.pdf;
              const code = item.data.links?.code;
              return (
                <li class="pub-card" id={item.id}>
                  <h3 class="pub-title">
                    {paper ? (
                      <a href={paper} target="_blank" rel="noopener noreferrer">
                        {titleText(item.data.title)}
                      </a>
                    ) : (
                      titleText(item.data.title)
                    )}
                  </h3>
                  <p class="pub-authors" set:html={formatAuthors(item.data.authors)} />
                  <p class="pub-meta">
                    <span>{item.data.venue}</span>
                    {pdf && (
                      <a class="pub-pdf" href={pdf} target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            fill="currentColor"
                            d="M6 2h9l5 5v15H6V2zm8 1.5V8h4.5L14 3.5zM8 11h8v1.5H8V11zm0 3h8v1.5H8V14zm0 3h5.5v1.5H8V17z"
                          />
                        </svg>
                        PDF
                      </a>
                    )}
                    {item.data.status === "accepted" && <span>Just accepted</span>}
                    {item.data.representative && <span>Representative</span>}
                  </p>
                  {item.data.summary && <p class="pub-summary">{item.data.summary}</p>}
                  {(item.data.tags.length > 0 || code) && (
                    <p class="pub-foot">
                      {item.data.tags.map((tag) => (
                        <span>{tag}</span>
                      ))}
                      {code && (
                        <a href={code} target="_blank" rel="noopener noreferrer">
                          Code
                        </a>
                      )}
                    </p>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>
