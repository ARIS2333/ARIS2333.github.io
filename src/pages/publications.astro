---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublications, groupByYear } from "../lib/content";
import { formatAuthors } from "../lib/profile";

const publications = await getPublications();
const groups = groupByYear(publications);
---

<BaseLayout
  title="Publications"
  description="Papers in reverse chronological order, with links to a manuscript, code, or project when one exists."
>
  <div class="shell">
    <header class="page-header">
      <h1>Publications</h1>
    </header>
    {
      groups.map((group) => (
        <section class="year-block" aria-labelledby={`year-${group.year}`}>
          <h2 id={`year-${group.year}`}>{group.year}</h2>
          <ol class="pub-list">
            {group.items.map((item) => {
              const paper = item.data.links?.paper;
              const code = item.data.links?.code;
              return (
                <li class="pub-card" id={item.id}>
                  <h3 class="pub-title">
                    {paper ? <a href={paper}>{item.data.title}</a> : item.data.title}
                  </h3>
                  <p class="pub-authors" set:html={formatAuthors(item.data.authors)} />
                  <p class="pub-meta">
                    <span>
                      {item.data.venue} {item.data.year}
                    </span>
                    {item.data.status === "accepted" && <span>Just accepted</span>}
                    {item.data.representative && <span>Representative</span>}
                  </p>
                  {item.data.summary && <p class="pub-summary">{item.data.summary}</p>}
                  {(item.data.tags.length > 0 || code) && (
                    <p class="pub-foot">
                      {item.data.tags.map((tag) => (
                        <span>{tag}</span>
                      ))}
                      {code && <a href={code}>Code</a>}
                    </p>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>
