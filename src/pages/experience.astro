---
import BaseLayout from "../layouts/BaseLayout.astro";
import RelatedList from "../components/RelatedList.astro";
import { getEducation, getExperience } from "../lib/content";
import { formatRange, formatYearRange, paragraphs } from "../lib/format";

const jobs = await getExperience();
const schools = await getEducation();

const recency = (end?: Date) => (end ? end.getTime() : Number.POSITIVE_INFINITY);

const workExperience = [...jobs].sort(
  (a, b) =>
    recency(b.entry.data.end) - recency(a.entry.data.end) ||
    b.entry.data.start.getTime() - a.entry.data.start.getTime(),
);
---

<BaseLayout
  title="Experience"
  description="Education and work experience, from newest to oldest."
>
  <div class="experience-page">
    <header class="page-header">
      <h1>Experience</h1>
    </header>
    <div class="experience-split">
      <section class="experience-pane" aria-labelledby="education-pane">
        <h2 id="education-pane" class="pane-head">Education</h2>
        <div class="record-list">
          {
            schools.map((entry) => (
              <article class="record">
                <h3>{entry.data.school}</h3>
                <div class="role-row">
                  <p class="role-line">
                    {entry.data.degree}, {entry.data.field}
                  </p>
                  <p class="dates">
                    {entry.data.precision === "year"
                      ? formatYearRange(entry.data.start, entry.data.end)
                      : formatRange(entry.data.start, entry.data.end)}
                  </p>
                </div>
                {entry.data.detail && <p class="team">{entry.data.detail}</p>}
                {(entry.data.advisor || entry.data.lab) && (
                  <p class="meta-line">
                    {entry.data.advisor && <>Advisor: {entry.data.advisor}</>}
                    {entry.data.advisor && entry.data.lab && " · "}
                    {entry.data.lab}
                  </p>
                )}
                {entry.data.note &&
                  paragraphs(entry.data.note).map((paragraph) => <p class="note">{paragraph}</p>)}
                {(entry.data.thesis || entry.data.thesisUrl) && (
                  <p class="meta-line">
                    {entry.data.thesisUrl ? (
                      <a href={entry.data.thesisUrl}>{entry.data.thesis || "Thesis"}</a>
                    ) : (
                      entry.data.thesis
                    )}
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </section>
      <section class="experience-pane" aria-labelledby="work-pane">
        <h2 id="work-pane" class="pane-head">Work Experience</h2>
        <div class="record-list">
          {
            workExperience.map((item) => (
              <article class="record">
                <h3>{item.entry.data.organization}</h3>
                {item.entry.data.team && <p class="team">{item.entry.data.team}</p>}
                <div class="role-row">
                  <p class="role-line">{item.entry.data.role}</p>
                  <p class="dates">{formatRange(item.entry.data.start, item.entry.data.end)}</p>
                </div>
                {item.entry.data.highlights.length > 0 && (
                  <ul>
                    {item.entry.data.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
                <RelatedList
                  items={item.relatedNotes.map((note) => ({
                    kind: "Note",
                    href: `/blog/${note.id}`,
                    title: note.data.title,
                  }))}
                />
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
