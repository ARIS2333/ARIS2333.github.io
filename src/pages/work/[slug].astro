---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedList from "../../components/RelatedList.astro";
import { getProjects, getPublicationsForProject, getPublishedNotesForProject } from "../../lib/content";
import { paragraphs } from "../../lib/format";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id } }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing project slug.");

const project = await getEntry("projects", slug);
if (!project) throw new Error(`Missing project "${slug}".`);

const publications = await getPublicationsForProject(project.id);
const notes = await getPublishedNotesForProject(project.id);
const body = project.body?.trim() ?? "";
const rendered = body ? await render(project) : null;

const related = [
  ...publications.map((item) => ({
    kind: item.data.links?.paper ? "Paper" : "Publication",
    href: item.data.links?.paper ?? `/publications#${item.id}`,
    title: item.data.title,
  })),
  ...(project.data.links?.code
    ? [{ kind: "Code", href: project.data.links.code, title: "Source code" }]
    : []),
  ...(project.data.links?.demo ? [{ kind: "Demo", href: project.data.links.demo, title: "Demo" }] : []),
  ...notes.map((note) => ({
    kind: "Note",
    href: `/blog/${note.id}`,
    title: note.data.title,
  })),
];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <div class="shell">
    <article class="article">
      <header class="article-header">
        <p class="kicker"><a href="/work">Work</a></p>
        <h1>{project.data.title}</h1>
        <p class="dek">{project.data.summary}</p>
      </header>

      <section class="answer">
        <h2>Problem</h2>
        {paragraphs(project.data.problem).map((paragraph) => <p>{paragraph}</p>)}
      </section>
      <section class="answer">
        <h2>My contribution</h2>
        {paragraphs(project.data.contribution).map((paragraph) => <p>{paragraph}</p>)}
      </section>
      <section class="answer">
        <h2>Outcome</h2>
        {paragraphs(project.data.outcome).map((paragraph) => <p>{paragraph}</p>)}
      </section>

      {rendered && <div class="prose"><rendered.Content /></div>}
      <RelatedList items={related} />
    </article>
  </div>
</BaseLayout>
