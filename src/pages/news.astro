---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNews } from "../lib/content";
import { formatISODate, formatNewsDate } from "../lib/format";

const news = await getNews();
---

<BaseLayout title="News" description="Paper acceptances, project milestones, and academic updates.">
  <div class="shell">
    <header class="page-header">
      <h1>News</h1>
      <p class="lede">Paper acceptances, project milestones, and academic updates.</p>
    </header>
    <ol class="news-list">
      {
        news.map((item) => (
          <li>
            <time datetime={formatISODate(item.data.date)}>{formatNewsDate(item.data.date)}</time>
            <span class="news-label">{item.data.label}</span>
            <p>
              {item.data.content}
              {item.data.href && (
                <>
                  {" "}
                  <a href={item.data.href} target="_blank" rel="noopener noreferrer">
                    {item.data.linkLabel || "Link"}
                  </a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
